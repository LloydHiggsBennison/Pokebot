{
  "name": "pokebot",
  "version": "1.0.0",
  "description": "Bot de Discord estilo Mudae para capturar Pokemon, con spawns configurables por mensajes y/o tiempo.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "setup:emojis": "node scripts/setup-emojis.js",
    "sprites": "node scripts/download-sprites.js",
    "test": "node --test test/*.test.js",
    "benchmark": "node test/benchmark.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": "22.x"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
